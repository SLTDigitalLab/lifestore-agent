# Copy this file to .env and fill in your own values.
GOOGLE_API_KEY=
# Set a Gemini model available to your account.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
# Optional legacy API token; the browser uses account sign-in.
CHAT_TEST_TOKEN=
# Optional: only used by the explicit OpenAI regression tests.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local Docker Compose database only.
DATABASE_URL=postgresql+psycopg://lifestore:lifestore_dev@db:5432/lifestore
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_PUBLIC_BASE_URL=https://shop.example.com

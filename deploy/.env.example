# Copy to the repository root as .env.prod. Never commit the filled copy.
DOMAIN=shop.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# Same password as above; percent-encode reserved characters if not using hex.
DATABASE_URL=postgresql+psycopg://lifestore:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/lifestore
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_PUBLIC_BASE_URL=https://shop.example.com
# Start with bootstrap for first issuance, then change to https.
NGINX_CONFIG=bootstrap
HTTP_PORT=80
HTTPS_PORT=443

# Private browsing demo configuration.
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_TEST_TOKEN=
